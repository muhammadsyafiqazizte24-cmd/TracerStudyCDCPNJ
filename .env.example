# ── Server & dashboard ──────────────────────────────────────────
PORT=3000
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=ganti-dengan-password-kuat
# Rahasia untuk endpoint webhook Apps Script (kosongkan = webhook nonaktif)
WEBHOOK_SECRET=ganti-dengan-string-acak-panjang

# ── Redis / BullMQ ──────────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379
QUEUE_NAME=tracer-wa

# ── WhatsApp (Baileys) ──────────────────────────────────────────
WA_AUTH_DIR=./auth_info_baileys
MAX_RECONNECT_ATTEMPTS=8
BAILEYS_LOG_LEVEL=silent

# ── Google Sheets (Service Account) ─────────────────────────────
GOOGLE_APPLICATION_CREDENTIALS=./credentials/service-account.json
GOOGLE_SPREADSHEET_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz
GOOGLE_SHEET_NAME=Sheet1
SHEET_FIRST_DATA_ROW=2
# Kolom keterangan alasan gagal (kosongkan untuk menulis alasan langsung di kolom E)
SHEET_DETAIL_COLUMN=G
POLL_INTERVAL_MS=5000

# ── Pesan ───────────────────────────────────────────────────────
SURVEY_URL=https://tracer.example.ac.id/kuesioner
SENDER_SIGNATURE=Tim Tracer Study CDC
MESSAGE_TEMPLATE_FILE=./templates/tracer.txt

# ── Anti-ban & pacing ───────────────────────────────────────────
JITTER_MIN_MS=30000
JITTER_MAX_MS=65000
# Kuota rolling 24 jam (disarankan 100–150)
DAILY_QUOTA=120
# Jam kirim (zona TIMEZONE). 0 dan 24 = tanpa batas jam
SEND_WINDOW_START=8
SEND_WINDOW_END=20
TIMEZONE=Asia/Jakarta
JOB_ATTEMPTS=3

LOG_LEVEL=info
